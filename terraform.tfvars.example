# Azure DevOps Organization URL
# Example: https://dev.azure.com/mycompany
azdo_org_url = "https://dev.azure.com/ntimakondu"

# Azure DevOps Project Name
# The project where User Story work items will be created
azdo_project = "wiz-issues"

# Note: This integration uses Managed Identity for authentication.
